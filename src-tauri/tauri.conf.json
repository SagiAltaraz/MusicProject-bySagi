{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DJ Crate",
  "version": "0.1.0",
  "identifier": "com.djcrate.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend"
  },
  "app": {
    "windows": [
      {
        "title": "DJ Crate",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3035 http://127.0.0.1:3035",
        "script-src": "'self' https://www.youtube.com https://s.ytimg.com",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com",
        "img-src": "'self' data: blob: https://i.ytimg.com https://*.ytimg.com https://yt3.ggpht.com",
        "media-src": "'self' blob: http://localhost:3035 http://127.0.0.1:3035",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
