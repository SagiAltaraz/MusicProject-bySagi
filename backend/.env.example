PORT=3035

# https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here
# https://platform.openai.com/api-keys (optional - only for the AI assistant)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Origins allowed to call the API (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost

# Browser yt-dlp reads YouTube cookies from (chrome, firefox, safari, edge, brave, none).
# Signed in with YouTube Premium, this unlocks the 256kbps streams.
# YTDLP_COOKIES_BROWSER=chrome

# Where finished downloads are saved
# DOWNLOAD_DIR=/Users/you/Music/DJ Crate
# DOWNLOAD_CONCURRENCY=2
# DOWNLOAD_TIMEOUT_SECONDS=900

# Optional explicit tool paths (e.g. bundled Tauri sidecars)
# YTDLP_PATH=
# FFMPEG_PATH=
# FFPROBE_PATH=

# LOG_LEVEL=info
